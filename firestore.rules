rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isStorefrontOwner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/adminConfig/primary)
        && get(/databases/$(database)/documents/adminConfig/primary).data.uid == request.auth.uid;
    }

    match /adminConfig/primary {
      allow read: if request.auth != null
        && (!exists(/databases/$(database)/documents/adminConfig/primary)
          || resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/adminConfig/primary)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /orders/{orderId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'id', 'customerId', 'customer', 'items', 'total', 'createdAt', 'updatedAt', 'status', 'activity'
        ])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'New';
      allow read: if isStorefrontOwner()
        || (request.auth != null && resource.data.customerId == request.auth.uid);
      allow update: if isStorefrontOwner();
      allow delete: if isStorefrontOwner();
    }

    match /users/{userId}/{collectionName}/{documentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isStorefrontOwner();
    }

    match /siteContent/{documentId} {
      allow read: if true;
      allow write: if isStorefrontOwner();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    match /workers/{workerId} {
      allow read, write: if false;
    }
  }
}