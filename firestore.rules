rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedStoreOwner() {
      return request.auth != null
        && request.auth.token.email == 'furnivisionsupport@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isStorefrontOwner() {
      return isVerifiedStoreOwner()
        && exists(/databases/$(database)/documents/adminConfig/primary)
        && get(/databases/$(database)/documents/adminConfig/primary).data.uid == request.auth.uid;
    }

    function isCustomerOrderUpdate() {
      return request.auth != null
        && resource.data.customerId == request.auth.uid
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customer', 'updatedAt', 'activity', 'status'])
        && (
          (
            resource.data.status in ['New', 'Confirmed', 'Preparing']
            && request.resource.data.status == resource.data.status
            && request.resource.data.customer.diff(resource.data.customer).affectedKeys().hasOnly(['address', 'city', 'postalCode', 'deliveryWindow', 'location'])
          )
          || (
            resource.data.status in ['New', 'Confirmed', 'Preparing', 'Ready for delivery']
            && request.resource.data.status == 'Cancelled'
            && request.resource.data.customer == resource.data.customer
          )
        );
    }

    match /adminConfig/primary {
      allow read: if isVerifiedStoreOwner();
      allow create: if isVerifiedStoreOwner()
        && !exists(/databases/$(database)/documents/adminConfig/primary)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is string;
      allow update: if isVerifiedStoreOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'id', 'customerId', 'customer', 'items', 'total', 'createdAt', 'updatedAt', 'status', 'activity'
        ])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'New';
      allow read: if isStorefrontOwner()
        || (request.auth != null && resource.data.customerId == request.auth.uid);
      allow update: if isStorefrontOwner() || isCustomerOrderUpdate();
      allow delete: if isStorefrontOwner();
    }

    match /users/{userId}/{collectionName}/{documentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isStorefrontOwner();
    }

    match /siteContent/{documentId} {
      allow read: if true;
      allow write: if isStorefrontOwner();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    match /workers/{workerId} {
      allow read, write: if false;
    }
  }
}