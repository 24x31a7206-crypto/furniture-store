rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isStorefrontOwner() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/adminConfig/primary).data.uid == request.auth.uid;
    }

    match /site/{fileName} {
      allow read: if true;
      allow create, update: if isStorefrontOwner()
        && request.resource.size < 60 * 1024 * 1024
        && request.resource.contentType.matches('(image|video)/.*');
      allow delete: if isStorefrontOwner();
    }

    match /users/{userId}/rooms/{fileName} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /deliveries/{workerId}/{fileName} {
      allow read: if isStorefrontOwner()
        || (request.auth != null && request.auth.uid == workerId);
      allow create, update: if request.auth != null
        && request.auth.uid == workerId
        && firestore.get(/databases/(default)/documents/workers/$(workerId)).data.active == true
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
